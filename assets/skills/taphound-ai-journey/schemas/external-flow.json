{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TapHound External Flow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "name", "description", "escapedPackageName", "includes", "steps"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "externalFlow" },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "description": { "type": "string", "minLength": 1 },
    "escapedPackageName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z_$][\\w$]*\\.)+[A-Za-z_$][\\w$]*$"
    },
    "expectedEscapeActivity": {
      "type": "string",
      "pattern": "^(?:[A-Za-z_$][\\w$]*\\.)+[A-Za-z_$][\\w$]*$"
    },
    "includes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}
