{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taphound.dev/schemas/observe-output.json",
  "title": "TapHound generation observe --json Output",
  "description": "Reference shape for the JSON result of `generation observe --json`. The agent parses this to extract binding fields and the full snapshot for the next proposed-step envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "exitCode", "generationId", "baseRevision", "snapshotHash", "snapshot"],
  "properties": {
    "status": { "const": "observed" },
    "exitCode": { "const": 0 },
    "generationId": {
      "type": "string",
      "pattern": "^[A-Za-z\\d](?:[A-Za-z\\d._-]*[A-Za-z\\d])?$"
    },
    "baseRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f\\d]{64}$" },
    "snapshot": {
      "type": "object",
      "description": "Full RuntimeSnapshot. See proposed-step-envelope.json $defs/RuntimeSnapshot for the detailed schema.",
      "required": ["version", "generationId", "baseRevision", "deviceSerial", "expectedPackageName", "foregroundPackageName", "activity", "pid", "capturedAt", "layout"],
      "properties": {
        "version": { "const": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "baseRevision": { "type": "integer", "minimum": 1 },
        "deviceSerial": { "type": "string", "minLength": 1 },
        "expectedPackageName": { "type": "string" },
        "foregroundPackageName": { "type": "string" },
        "activity": { "type": "string" },
        "pid": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "capturedAt": { "type": "string" },
        "screenshotPath": { "type": "string" },
        "layout": { "type": "array" },
        "windowHierarchy": {
          "type": "object",
          "description": "Conservative comparison between visible touchable target-app windows and semantic layout roots. An incomplete status must block proposal generation."
        }
      }
    }
  }
}
