{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taphound.dev/schemas/case-ledger-v1.json",
  "title": "TapHound Case Suite Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "kind", "suiteId", "revision", "catalog",
    "devicePolicy", "baseFlows", "cases", "updatedAt"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "taphound.caseLedger" },
    "suiteId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "cases.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "devicePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency"],
      "properties": {
        "concurrency": { "const": "serial" },
        "deviceSerial": { "type": "string", "minLength": 1 }
      }
    },
    "baseFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "status", "path", "sha256", "exitActivity",
          "journey", "resolutionManifest", "report", "recordedAt"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "const": "verified" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "exitActivity": { "type": "string", "minLength": 1 },
          "journey": { "$ref": "#/$defs/artifact" },
          "resolutionManifest": { "$ref": "#/$defs/artifact" },
          "report": { "$ref": "#/$defs/artifact" },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "order", "title", "sourceSha256", "risk", "dependsOn",
          "status", "history"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "risk": { "enum": ["readOnly", "stateChanging", "external"] },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "plannedBaseFlow": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "pending", "briefing", "briefReady", "generating",
              "recoveryRequired", "verificationPending",
              "verificationFailed", "blocked", "verified", "archived"
            ]
          },
          "resumeStatus": { "type": "string", "minLength": 1 },
          "brief": { "$ref": "#/$defs/artifact" },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "baseFlow": { "type": "string", "minLength": 1 }
            }
          },
          "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          },
          "nextAction": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "completion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["journey", "meta", "finalReport", "independentReport"],
            "properties": {
              "journey": { "$ref": "#/$defs/artifact" },
              "meta": { "$ref": "#/$defs/artifact" },
              "finalReport": { "$ref": "#/$defs/artifact" },
              "independentReport": { "$ref": "#/$defs/artifact" }
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "at", "reason"],
              "properties": {
                "from": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "format": "date-time" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          }
        }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
