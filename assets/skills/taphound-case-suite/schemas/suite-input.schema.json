{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taphound.dev/schemas/case-suite-input-v1.json",
  "title": "TapHound Case Suite Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suiteId", "title", "projectRoot", "cases"],
  "properties": {
    "version": { "const": 1 },
    "suiteId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "projectRoot": { "type": "string", "minLength": 1 },
    "deviceSerial": { "type": "string", "minLength": 1 },
    "contextPath": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "sourceText", "risk", "dependsOn"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceText": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "risk": { "enum": ["readOnly", "stateChanging", "external"] },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" }
        },
        "plannedBaseFlow": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
