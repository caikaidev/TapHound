{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taphound.dev/schemas/case-transition-v1.json",
  "title": "TapHound Case Ledger Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "expectedRevision", "caseId", "from", "to", "reason"
  ],
  "properties": {
    "version": { "const": 1 },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "caseId": { "type": "string", "minLength": 1 },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "brief": { "$ref": "case-ledger-v1.json#/$defs/artifact" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "baseFlow": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey", "meta", "finalReport", "independentReport"],
      "properties": {
        "journey": { "$ref": "case-ledger-v1.json#/$defs/artifact" },
        "meta": { "$ref": "case-ledger-v1.json#/$defs/artifact" },
        "finalReport": { "$ref": "case-ledger-v1.json#/$defs/artifact" },
        "independentReport": { "$ref": "case-ledger-v1.json#/$defs/artifact" }
      }
    }
  }
}
