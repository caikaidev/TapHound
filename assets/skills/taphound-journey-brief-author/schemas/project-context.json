{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taphound.dev/schemas/project-context.json",
  "title": "TapHound Project Context Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packageName",
    "launchActivity",
    "manifest",
    "interactionPolicy",
    "modules"
  ],
  "properties": {
    "version": { "const": 2 },
    "packageName": { "$ref": "#/$defs/qualifiedName" },
    "launchActivity": { "$ref": "#/$defs/qualifiedName" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "interactionPolicy": { "$ref": "#/$defs/interactionPolicy" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "application" } }
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "projectDir",
          "kind",
          "contextPath",
          "sha256",
          "features",
          "activities",
          "dependsOn",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "projectDir": { "$ref": "#/$defs/projectPath" },
          "kind": { "enum": ["application", "feature", "library"] },
          "contextPath": { "$ref": "#/$defs/projectPath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "activities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/qualifiedName" }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "$ref": "#/$defs/shardStatus" }
        }
      }
    }
  },
  "$defs": {
    "qualifiedName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z_$][\\w$]*\\.)+[A-Za-z_$][\\w$]*$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f\\d]{64}$"
    },
    "shardStatus": {
      "enum": ["complete", "partial", "unsupported", "notAnalyzed"]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "files"],
      "properties": {
        "version": { "const": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "confidence"],
            "properties": {
              "path": { "$ref": "#/$defs/projectPath" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "semanticSha256": { "$ref": "#/$defs/sha256" },
              "confidence": {
                "enum": [
                  "sourceConfirmed",
                  "runtimeConfirmed",
                  "inferred",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "action": {
      "enum": [
        "click",
        "longClick",
        "inputText",
        "swipe",
        "scrollTo",
        "back",
        "wait"
      ]
    },
    "interactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedActions",
        "confirmationRequiredActions",
        "forbiddenActions"
      ],
      "properties": {
        "allowedActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "confirmationRequiredActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "forbiddenActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  }
}
