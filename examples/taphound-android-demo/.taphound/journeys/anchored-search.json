{
  "version": 2,
  "name": "anchored-search",
  "devices": [{ "role": "default" }],
  "steps": [
    {
      "action": "click",
      "anchor": "demo.search.open",
      "locator": { "resourceId": "open_search" },
      "activity": {
        "before": "dev.taphound.demo.MainActivity",
        "after": "dev.taphound.demo.SearchActivity"
      },
      "expect": { "type": "element", "locator": { "resourceId": "search_input" }, "timeoutMs": 10000 }
    },
    {
      "action": "click",
      "anchor": "demo.search.input",
      "locator": { "resourceId": "search_input" },
      "activity": {
        "before": "dev.taphound.demo.SearchActivity",
        "after": "dev.taphound.demo.SearchActivity"
      }
    },
    {
      "action": "inputText",
      "text": "hello world",
      "activity": {
        "before": "dev.taphound.demo.SearchActivity",
        "after": "dev.taphound.demo.SearchActivity"
      }
    },
    {
      "action": "click",
      "anchor": "demo.search.submit",
      "locator": { "resourceId": "submit_search" },
      "activity": {
        "before": "dev.taphound.demo.SearchActivity",
        "after": "dev.taphound.demo.SearchActivity"
      },
      "expect": { "type": "logcat", "tag": "SearchViewModel", "level": "I", "pattern": "submitted query=hello world", "match": "literal", "timeoutMs": 3000 }
    }
  ]
}
